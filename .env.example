# Copy to .env and supply your own secret and PostgreSQL password.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=ride_sharing
DB_USER=ride_sharing
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=10

# Vercel uses a hosted PostgreSQL URL instead of the DB_* values above.
# Set these in Vercel project environment variables; do not upload .env.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Redis is optional for one-process local development and required across workers.
REDIS_URL=
PUBLIC_BASE_URL=http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=False

# Fare quotes use straight-line distance multiplied by the road factor.
RIDE_CURRENCY=BDT
FARE_BASE=50.00
FARE_PER_KM=22.00
FARE_MINIMUM=80.00
FARE_ROAD_FACTOR=1.3
PLATFORM_FEE_PERCENT=15
MATCH_RADIUS_KM=10
MAP_CENTER_LATITUDE=23.8103
MAP_CENTER_LONGITUDE=90.4125
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION="© OpenStreetMap contributors"

# Optional hosted card checkout. Leave empty to use cash only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Password recovery email. Local settings print messages in the server terminal.
# Production uses SMTP; use TLS on port 587 or SSL on 465, never both.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL="Nori <noreply@example.com>"
